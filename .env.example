# Solana Configuration
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Treasury wallet (receives private payments)
TREASURY_WALLET=YOUR_TREASURY_PUBLIC_KEY

# User private key (base58 encoded)
USER_PRIVATE_KEY=YOUR_PRIVATE_KEY_BASE58

# Server configuration (for Express examples)
PORT=3001
